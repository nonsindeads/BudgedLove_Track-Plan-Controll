# BudgetLove example environment
# Copy to .env and replace all values before production use.

HB_DB_PASS=change_this_postgres_password
HB_WS_SECRET=change_this_websocket_secret

# Optional, used for absolute links in integrations.
APP_BASE_URL=https://app.example.com

# Set to 1 when running behind a trusted reverse proxy.
HB_TRUST_PROXY=1

